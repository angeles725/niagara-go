 838 |   public void doEscalateAlarms()
 839 |   {
 840 |     if (!isRunning() || !isOperational())
 841 |     {
 842 |       return;
 843 |     }
 844 | 
 845 |     try
 846 |     {
 847 |       // Build a query to get all open alarms for classes that are using escalation
 848 |       StringBuilder bql = new StringBuilder("alarm:|bql:select from openAlarms ");
 849 | 
 850 |       int classCount = 0;
 851 |       boolean escalationInUse = false;
 852 |       for (BAlarmClass alarmClass : getAlarmClasses())
 853 |       {
 854 |         if (alarmClass.getEscalationLevel1Enabled() ||
 855 |           alarmClass.getEscalationLevel2Enabled() ||
 856 |           alarmClass.getEscalationLevel3Enabled())
 857 |         {
 858 |           escalationInUse = true;
 859 | 
 860 |           if (classCount != 0)
 861 |           {
 862 |             bql.append("or ");
 863 |           }
 864 |           else
 865 |           {
 866 |             bql.append("where (");
 867 |           }
 868 |           ++classCount;
 869 | 
 870 |           bql.append("alarmClass='");
 871 |           bql.append(SlotPath.escape(alarmClass.getName()));
 872 |           bql.append("' ");
 873 |         }
 874 |       }
 875 | 
 876 |       if (classCount > 0)
 877 |       {
 878 |         bql.append(')');
 879 |       }
 880 | 
 881 |       // If no classes are using escalation, then we don't need to
 882 |       // continue
 883 |       if (!escalationInUse)
 884 |       {
 885 |         return;
 886 |       }
 887 | 
 888 |       // Execute the query
 889 |       @SuppressWarnings("unchecked") BITable<BAlarmRecord> table = (BITable<BAlarmRecord>) BOrd.make(bql.toString()).get(this);
 890 |       // Storage for alarms needing to be updated
 891 |       Map<BUuid, BAlarmRecord> updates = new HashMap<>();
 892 |       try (Cursor<BAlarmRecord> cur = table.cursor())
 893 |       {
 894 |         while (cur.next())
 895 |         {
 896 |           BAlarmRecord record = cur.get();
 897 |           if (record.getAckState() == BAckState.unacked)
 898 |           {
 899 |             BAlarmClass alarmClass = lookupAlarmClass(record.getAlarmClass());
 900 | 
 901 |             BObject escalatedValue = record.getAlarmData().get(BAlarmClass.ESCALATED);
 902 |             if (alarmClass.getEscalationLevel1Enabled() && escalatedValue.equals(BString.DEFAULT))
 903 |             {
 904 |               // if it's never been escalated, we can check level 1
 905 |               if (record.getTimestamp().add(alarmClass.getEscalationLevel1Delay()).isBefore(BAbsTime.now()))
 906 |               {
 907 |                 record.addAlarmFacet(BAlarmClass.ESCALATED, BString.make(BAlarmClass.LEVEL_1));
 908 |                 updates.put(record.getUuid(), (BAlarmRecord)record.newCopy());
 909 |                 if (logger.isLoggable(Level.FINE))
 910 |                 {
 911 |                   logger.fine("Escalating " + record.getUuid() + " to level 1");
 912 |                 }
 913 |               }
 914 |             }
 915 |             else if (alarmClass.getEscalationLevel2Enabled() &&
 916 |               (escalatedValue.equals(LEVEL_1_STRING) || escalatedValue.equals(BString.DEFAULT)))
 917 |             {
 918 |               // if it's at level 1 (or 0), we can check level 2
 919 |               if (record.getTimestamp().add(alarmClass.getEscalationLevel2Delay()).isBefore(BAbsTime.now()))
 920 |               {
 921 |                 // escalate the alarm
 922 |                 record.addAlarmFacet(BAlarmClass.ESCALATED, BString.make(BAlarmClass.LEVEL_2));
 923 |                 updates.put(record.getUuid(), (BAlarmRecord)record.newCopy());
 924 |                 if (logger.isLoggable(Level.FINE))
 925 |                 {
 926 |                   logger.fine("Escalating " + record.getUuid() + " to level 2");
 927 |                 }
 928 |               }
 929 |             }
 930 |             else if (alarmClass.getEscalationLevel3Enabled() &&
 931 |               (escalatedValue.equals(LEVEL_2_STRING) || escalatedValue.equals(LEVEL_1_STRING) || escalatedValue.equals(BString.DEFAULT)))
 932 |             {
 933 |               // if it's at level 2 (or 1 or 0), we can check level 3
 934 |               if (record.getTimestamp().add(alarmClass.getEscalationLevel3Delay()).isBefore(BAbsTime.now()))
 935 |               {
 936 |                 // escalate the alarm
 937 |                 record.addAlarmFacet(BAlarmClass.ESCALATED, BString.make(BAlarmClass.LEVEL_3));
 938 |                 updates.put(record.getUuid(), (BAlarmRecord)record.newCopy());
 939 |                 if (logger.isLoggable(Level.FINE))
 940 |                 {
 941 |                   logger.fine("Escalating " + record.getUuid() + " to level 3");
 942 |                 }
 943 |               }
 944 |             }
 945 |           }
 946 |         }
 947 |       }
 948 | 
 949 |       try (AlarmDbConnection connection = getAlarmDb().getDbConnection(null))
 950 |       {
 951 |         for (BAlarmRecord record : updates.values())
 952 |         {
 953 |           connection.update(record);
 954 | 
 955 |           BAlarmClass alarmClass = lookupAlarmClass(record.getAlarmClass());
 956 | 
 957 |           BObject escalatedValue = record.getAlarmData().get(BAlarmClass.ESCALATED);
 958 |           if (escalatedValue.equals(LEVEL_1_STRING))
 959 |           {
 960 |             alarmClass.fireAlarm(record);
 961 |             alarmClass.fireEscalatedAlarm1(record);
 962 |           }
 963 |           else if (escalatedValue.equals(LEVEL_2_STRING))
 964 |           {
 965 |             alarmClass.fireAlarm(record);
 966 |             alarmClass.fireEscalatedAlarm1(record);
 967 |             alarmClass.fireEscalatedAlarm2(record);
 968 |           }
 969 |           else if (escalatedValue.equals(LEVEL_3_STRING))
 970 |           {
 971 |             alarmClass.fireAlarm(record);
 972 |             alarmClass.fireEscalatedAlarm1(record);
 973 |             alarmClass.fireEscalatedAlarm2(record);
 974 |             alarmClass.fireEscalatedAlarm3(record);
 975 |           }
 976 |         }
 977 |       }
 978 |     }
 979 |     catch(Exception e)
 980 |     {
 981 |       logThrowable("Exception while checking for alarms to escalate", e);
 982 |     }
 983 |   }
