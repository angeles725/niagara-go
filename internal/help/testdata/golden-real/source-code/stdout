 986 |    * If an ack is required, route the alarm to the source.
 987 |    * Otherwise, set it to be acked and route it back to the recipients.
 988 |    */
 989 |   public void doAckAlarm(BAlarmRecord alarm)
 990 |     throws Exception
 991 |   {
 992 |     BObject source = null;
 993 |     try
 994 |     {
 995 |       // Resolve the source of the alarm so we can check the source's type.
 996 |       source = resolveAlarmSource(alarm);
 997 |     }
 998 |     catch (UnresolvedException e)
 999 |     {
1000 |       //ignore this Exception since doRouteToSource will handle it
1001 |     }
1002 | 
1003 |     if (source instanceof BIRemoteAlarmSource)
1004 |     {
1005 |       //Issue 13921
1006 |       doRouteToSource(alarm, source);
1007 |     }
1008 |     else
1009 |     {
1010 |       if (alarm.getAckRequired())
1011 |       {
1012 |         doRouteToSource(alarm, source);
1013 |       }
1014 |       else
1015 |       {
1016 |         alarm.setAckState(BAckState.acked);
1017 |         doRouteToRecipient(alarm);
1018 |       }
1019 |     }
1020 |   }
