1059 |   public void doRouteToSource(BAlarmRecord alarm)
1060 |     throws Exception
1061 |   {
1062 |     BObject source = null;
1063 |     try
1064 |     {
1065 |       // Resolve the source of the alarm so we can check the source's type.
1066 |       source = resolveAlarmSource(alarm);
1067 |     }
1068 |     catch (UnresolvedException e)
