1596 |   class PlatformServiceListener
1597 |     implements PlatformServiceAlarmListener
1598 |   {
1599 |     @Override
1600 |     public void platformServiceAlarm(BPlatformServiceAlarmRecord platformServiceAlarm)
1601 |     {
1602 |       if (!isRunning())
1603 |       {
1604 |         throw new NotRunningException("Alarm Service is not running, unable to process platform alarm record");
1605 |       }
1606 | 
1607 |       //  Translate platform service alarm transition to BAlarmTransition
1608 |       BPlatformServiceSourceState pt = platformServiceAlarm.getSourceState();
1609 |       BSourceState sourceState;
1610 | 
1611 |       if (pt == BPlatformServiceSourceState.normal)
1612 |       {
1613 |         platformServiceToNormal(platformServiceAlarm);
1614 |         return;
1615 |       }
1616 | 
1617 |       if (pt == BPlatformServiceSourceState.offnormal)
1618 |       {
1619 |         sourceState = BSourceState.offnormal;
1620 |       }
1621 |       else if (pt == BPlatformServiceSourceState.fault)
1622 |       {
1623 |         sourceState = BSourceState.fault;
1624 |       }
1625 |       else if (pt == BPlatformServiceSourceState.alert)
1626 |       {
1627 |         sourceState = BSourceState.alert;
1628 |       }
1629 |       else
1630 |       {
1631 |         throw new IllegalStateException();
1632 |       }
1633 | 
1634 |       BAlarmRecord alarm = null;
1635 |       try (AlarmDbConnection conn = getAlarmDb().getDbConnection(null))
1636 |       {
1637 |         alarm = conn.getRecord(platformServiceAlarm.getUuid());
1638 |       }
1639 |       catch (Exception e) { }
1640 |       if (alarm == null)
1641 |       {
1642 |         //  Create alarm record
1643 |         alarm = new BAlarmRecord(platformServiceAlarm.getSource(),
1644 |                                  platformServiceAlarm.getAlarmClass(),
1645 |                                  platformServiceAlarm.getAlarmData(),
1646 |                                  BUuid.DEFAULT);
1647 |         alarm.setUuid(platformServiceAlarm.getUuid());
1648 |         alarm.setTimestamp(platformServiceAlarm.getTimestamp());
1649 |       }
1650 | 
1651 |       alarm.setSourceState(sourceState);
1652 |       alarm.setAlarmTransition(sourceState);
1653 |       //ackState is set in doAckAlarm
1654 | 
1655 |       routeAlarm(alarm);
1656 |     }
1657 | 
1658 |     public void platformServiceToNormal(BPlatformServiceAlarmRecord platformServiceAlarm)
1659 |     {
1660 |       if (!isRunning())
1661 |       {
1662 |         throw new NotRunningException("Alarm Service is not running, unable to process platform toNormal record");
1663 |       }
1664 | 
1665 |       try (AlarmDbConnection conn = getAlarmDb().getDbConnection(null);
1666 |            Cursor<BAlarmRecord> cur = conn.getAlarmsForSource(BOrdList.make(platformServiceAlarm.getSource())))
1667 |       {
1668 |         while (cur.next())
1669 |         {
1670 |           BAlarmRecord alarm = cur.get();
1671 |           if (!alarm.isNormal())
1672 |           {
1673 |             // Make the record normal and route it to recipients
1674 |             alarm.setAlarmClass(platformServiceAlarm.getAlarmClass());
1675 |             alarm.setAlarmData(BFacets.make(alarm.getAlarmData(), platformServiceAlarm.getAlarmData()));
1676 |             alarm.setNormalTime(platformServiceAlarm.getTimestamp());
1677 |             alarm.setSourceState(BSourceState.normal);
1678 |             routeAlarm((BAlarmRecord) alarm.newCopy());
1679 |           }
1680 |         }
1681 |       }
1682 |       catch(Exception e) { logger.log(Level.SEVERE, "Unable to generate toNormal PlatformServiceAlarm for: " + platformServiceAlarm.getSource(), e); }
1683 |     }
1684 |   }
