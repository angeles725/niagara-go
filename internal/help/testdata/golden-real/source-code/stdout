1074 |   /**
1075 |    * Route an alarm record to the source of the alarm.
1076 |    *
1077 |    * @param alarm The alarm to route.
1078 |    */
1079 |   public void doRouteToSource(BAlarmRecord alarm, BObject source)
1080 |     throws Exception
1081 |   {
1082 |     // is this an alarm ack?
1083 |     boolean isAck = alarm.getAckState() == BAckState.ackPending ||
1084 |       (alarm.getAckState() == BAckState.acked && alarm.getAckRequired());
1085 | 
1086 |     if (source == null)
1087 |     {
1088 |       logger.severe("BAlarmService.doRouteToSource cannot resolve alarm source " + alarm.getSource());
1089 | 
1090 |       if (isAck)
1091 |       {
1092 |         alarm.setAckState(BAckState.acked);
1093 |         alarm.setAckTime(BAbsTime.now());
1094 |         alarm.setAckRequired(false);
1095 |         alarm.addAlarmFacet("autoAcked", BString.make("Cannot resolve: " + alarm.getSource()));
1096 |         doRouteToRecipient(alarm);
1097 |       }
1098 | 
1099 |       return;
1100 |     }
1101 | 
1102 |     // If it's an ack request, have the source ack the alarm.
1103 |     if (logger.isLoggable(Level.FINE))
1104 |     {
1105 |       logger.fine("BAlarmService.doRouteToSource: " + source);
1106 |     }
1107 | 
1108 |     if (source instanceof BIAlarmSource)
1109 |     {
1110 |       try
1111 |       {
1112 |         if (isAck)
1113 |         {
1114 |           ((BIAlarmSource) source).ackAlarm(alarm);
1115 |         }
1116 |         else if (source instanceof BIUpdatableAlarmSource)
1117 |         {
1118 |           BIUpdatableAlarmSource ext = (BIUpdatableAlarmSource)source;
1119 |           ext.updateAlarm(alarm);
1120 |         }
1121 |       }
1122 |       catch(Exception e)
1123 |       {
1124 |         if (e instanceof BajaRuntimeException)
1125 |         {
1126 |           throw (Exception)e.getCause();
1127 |         }
1128 |         else
1129 |         {
1130 |           throw e;
1131 |         }
1132 |       }
1133 |     }
1134 |     else if (isAck && source instanceof BIAlarmablePlatformService)
1135 |     {
1136 |       //  Translate BAlarmTransition to BPlatformServiceAlarmState
1137 |       BPlatformServiceSourceState transState;
1138 |       BSourceState state = alarm.getAlarmTransition();
1139 |       if (state == BSourceState.offnormal)
1140 |       {
1141 |         transState = BPlatformServiceSourceState.offnormal;
1142 |       }
1143 |       else if (state == BSourceState.fault)
1144 |       {
1145 |         transState = BPlatformServiceSourceState.fault;
1146 |       }
1147 |       else if (state == BSourceState.alert)
1148 |       {
1149 |         transState = BPlatformServiceSourceState.alert;
1150 |       }
1151 |       else
1152 |       {
1153 |         throw new IllegalStateException();
1154 |       }
1155 | 
1156 |       BOrdList stackedSource = alarm.getSource();
1157 |       BOrd localSource = stackedSource.get(stackedSource.size()-1);
1158 | 
1159 |       BPlatformServiceAlarmRecord record = new BPlatformServiceAlarmRecord(localSource,
1160 |         alarm.getAlarmClass(),
1161 |         transState,
1162 |         alarm.getAlarmData());
1163 |       record.setTimestamp(alarm.getTimestamp());
1164 | 
1165 |       ((BIAlarmablePlatformService) source).ackAlarm(record);
1166 | 
1167 |       alarm.setAckState(BAckState.acked);
1168 |       alarm.setAckTime(BAbsTime.now());
1169 |       alarm.setAckRequired(false);
1170 |       alarm.setAlarmClass(record.getAlarmClass());
1171 | 
1172 |       doRouteToRecipient(alarm);
1173 |     }
1174 |   }
