1442 |   /**
1443 |    * Utility method to compare the remote version of the alarm module to the version string passed in as a parameter.
1444 |    *
1445 |    * @since Niagara 4.9
1446 |    * @param versionString the version string to compare against the remote version of the alarm module.
1447 |    * @return Returns boolean: true if the remote version of the alarm module is greater than or equal to the
1448 |    * versionString parameter passed in as a parameter, otherwise false.
1449 |    */
1450 |   private boolean remoteVersionGtOrEq(String versionString)
1451 |   {
1452 |     boolean result = false;
1453 | 
1454 |     if (remoteVersion == null)
1455 |     {
1456 |       try
1457 |       {
1458 |         remoteVersion  = (Version)((BFoxSession)getSession()).fw(Fw.GET_REMOTE_VERSION, "alarm", null, null, null);
1459 |       }
1460 |       catch(Exception ignore) {}
1461 |     }
1462 |     if (remoteVersion != null && !remoteVersion.isNull())
1463 |     {
1464 |       result = remoteVersion.compareTo(new Version(versionString)) >= 0;
1465 |     }
1466 | 
1467 |     return result;
1468 |   }
