#!/usr/bin/env bash
# Fast gate: formatting, vet, short tests (includes the size gate).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
unformatted=$(gofmt -l $(git ls-files '*.go') 2>/dev/null || true)
if [ -n "$unformatted" ]; then
  echo "gofmt needed:" >&2
  echo "$unformatted" >&2
  exit 1
fi
go vet ./...
go test -short ./...
